ARG DEBIAN_TAG
ARG DOCKER_REPO
FROM ${DOCKER_REPO}docker:cli as docker-cli
FROM ${DOCKER_REPO}debian:${DEBIAN_TAG}

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  ca-certificates dos2unix gnupg python3 python3-pip python3-venv python3-dev libxml2-utils xsltproc curl git \
  -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" \
  && update-ca-certificates \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/

# Create and activate virtual environment
RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

# Install Python packages inside the virtual environment
RUN pip3 install --break-system-packages \
    MarkupSafe==3.0.3 anyio==4.13.0 argon2-cffi==25.1.0 argon2-cffi-bindings==25.1.0 arrow==1.4.0 asttokens==3.0.1 async-lru==2.3.0 attrs==26.1.0 babel==2.18.0 beautifulsoup4==4.14.3 bleach==6.3.0 certifi==2026.5.20 cffi==2.0.0 charset_normalizer==3.4.7 clang-format==22.1.5 click==8.4.1 comm==0.2.3 contourpy==1.3.3 cycler==0.12.1 datacompy==0.19.5 debugpy==1.8.21 decorator==5.3.1 defusedxml==0.7.1 elementpath==5.1.1 entrypoints==0.4 et-xmlfile==2.0.0 execnet==2.1.2 executing==2.2.1 fastjsonschema==2.21.2 fonttools==4.63.0 fqdn==1.5.1 h11==0.16.0 httpcore==1.0.9 httpx==0.28.1 idna==3.17 iniconfig==2.3.0 ipykernel==7.2.0 ipython==9.14.0 ipython-pygments-lexers==1.1.1 ipywidgets==8.1.8 isoduration==20.11.0 jedi==0.20.0 jinja2==3.1.6 json5==0.14.0 jsondiff==2.2.1 jsonpointer==3.1.1 jsonschema==4.26.0 jsonschema-specifications==2025.9.1 jupyter==1.1.1 jupyter-client==8.8.0 jupyter-console==6.6.3 jupyter-core==5.9.1 jupyter-events==0.12.1 jupyter-lsp==2.3.1 jupyter-server==2.19.0 jupyter-server-terminals==0.5.4 jupyterlab-4.5.7 jupyterlab-pygments==0.3.0 jupyterlab-server==2.28.0 jupyterlab_widgets==3.0.16 kiwisolver==1.5.0 lark==1.3.1 lxml==6.1.1 matplotlib==3.10.9 matplotlib-inline==0.2.2 mistune==3.2.1 nbclient==0.10.4 nbconvert==7.17.1 nbformat==5.10.4 nest-asyncio==1.6.0 notebook==7.5.6 notebook-shim==0.2.4 numpy==2.4.3 openpyxl==3.1.5 ordered-set==4.1.0 packaging==26.2 pandas==2.3.3 pandocfilters==1.5.1 papermill==2.7.0 parso==0.8.7 pexpect==4.9.0 pillow==12.2.0 platformdirs==4.10.0 pluggy==1.6.0 polars==1.38.1 polars-runtime-32==1.38.1 prometheus-client==0.25.0 prompt_toolkit==3.0.52 psutil==7.2.2 ptyprocess==0.7.0 pure-eval==0.2.3 pyarrow==24.0.0 pycparser==3.0 pygments==2.20.0 pyparsing==3.3.2 pytest==9.0.3 pytest-rerunfailures==16.3 pytest-timeout==2.4.0 pytest-xdist==3.8.0 python-dateutil==2.9.0.post0 python-dotenv==1.2.2 python-json-logger==4.1.0 pytz==2026.2 pyyaml==6.0.3 pyzmq==27.1.0 referencing==0.37.0 requests==2.34.2 rfc3339-validator==0.1.4 rfc3986-vali