<SensitivityAnalysis>

  <DiscountCurves>
    <DiscountCurve ccy="USD">
      <ShiftType>Absolute</ShiftType>
      <ShiftSize>0.0001</ShiftSize>
      <ShiftTenors>1D,1W,1M,6M,1Y,2Y,3Y,5Y,7Y,10Y</ShiftTenors>
    </DiscountCurve>
  </DiscountCurves>

  <IndexCurves/>

  <FxSpots>
    <FxSpot ccypair="USDEUR">
      <ShiftType>Relative</ShiftType>
      <ShiftSize>0.01</ShiftSize>
    </FxSpot>
  </FxSpots>

  <!-- A one basis point relative spot shift. One hour before expiry the one standard deviation move of the
       underlying is a fraction of a percent, so the usual 1% shift straddles the whole gamma peak and
       understates gamma severalfold. -->
  <EquitySpots>
    <EquitySpot equity="SP5">
      <ShiftType>Relative</ShiftType>
      <ShiftSize>0.0001</ShiftSize>
    </EquitySpot>
  </EquitySpots>

  <CrossGammaFilter/>

</SensitivityAnalysis>
